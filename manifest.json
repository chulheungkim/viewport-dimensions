{
  "manifest_version": 3,
  "name": "Viewport Dimensions",
  "version": "0.2.0",
  "description": "Shows viewport width and height while resizing, at one of six selectable positions, then smoothly hides.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Viewport display settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["preferences.js", "resize-controller.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
