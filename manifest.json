{
  "manifest_version": 3,
  "name": "Viewport Dimensions",
  "version": "0.4.0",
  "description": "Live viewport dimensions, smooth resizing, and mobile preview windows with phone, tablet, laptop, and monitor presets.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "toggle-toolbar": {
      "suggested_key": { "default": "Alt+Shift+V", "mac": "Alt+Shift+V" },
      "description": "Toggle the viewport device toolbar"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Viewport display settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "preferences.js",
        "device-presets.js",
        "resize-controller.js",
        "toolbar-styles.js",
        "toolbar.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
